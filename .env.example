NODE_ENV=development
# Application connects as a NON-superuser role without BYPASSRLS
DATABASE_URL=postgres://rakan_app:rakan_app_dev@localhost:5432/rakan
# Migrations run as the schema owner
MIGRATION_DATABASE_URL=postgres://rakan_owner:rakan_owner_dev@localhost:5432/rakan
# Used only by `pnpm db:setup` to create roles/database in development
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

API_PORT=4000
WEB_ORIGIN=http://localhost:3000
SESSION_IDLE_HOURS=12
COOKIE_SECURE=false
# SMTP for outgoing mail (Mailpit in dev). Empty = log emails to console (dev only).
# Production refuses to start without SMTP_URL and COOKIE_SECURE=true.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Rakan <no-reply@rakan.local>"
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=info
# Web -> API proxy target (server side only)
API_INTERNAL_URL=http://localhost:4000
# Field encryption master key (32 random bytes, base64). REQUIRED in production; keep it in a secret manager.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
IMPORT_MAX_ROWS=5000
# Voice: Rakan's spokesperson voice (ElevenLabs). Server-side only; without it voice stays "not configured".
ELEVENLABS_API_KEY=
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v1
# Approximate prices used for budgeting (USD); match them to your ElevenLabs plan.
# VOICE_TTS_USD_PER_1K_CHARS=0.3
# VOICE_STT_USD_PER_MINUTE=0.007
