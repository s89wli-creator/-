NODE_ENV=development
# Application connects as a NON-superuser role without BYPASSRLS
DATABASE_URL=postgres://rakan_app:rakan_app_dev@localhost:5432/rakan
# Migrations run as the schema owner
MIGRATION_DATABASE_URL=postgres://rakan_owner:rakan_owner_dev@localhost:5432/rakan
# Used only by `pnpm db:setup` to create roles/database in development
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

API_PORT=4000
WEB_ORIGIN=http://localhost:3000
SESSION_IDLE_HOURS=12
COOKIE_SECURE=false
# SMTP for outgoing mail (Mailpit in dev). Empty = log emails to console (dev only).
# Production refuses to start without SMTP_URL and COOKIE_SECURE=true.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Rakan <no-reply@rakan.local>"
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=info
# Web -> API proxy target (server side only)
API_INTERNAL_URL=http://localhost:4000
