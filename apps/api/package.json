{
  "name": "@rakan/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput > /dev/null & node --watch --env-file=../../.env dist/main.js)",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:isolation:app-layer": "DATABASE_URL=$MIGRATION_DATABASE_URL vitest run test/tenant-isolation.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/throttler": "6.4.0",
    "@node-rs/argon2": "2.0.2",
    "@rakan/db": "workspace:*",
    "@rakan/shared": "workspace:*",
    "cookie-parser": "1.4.7",
    "csv-parse": "5.6.0",
    "drizzle-orm": "0.44.7",
    "exceljs": "4.4.0",
    "helmet": "8.1.0",
    "nestjs-pino": "4.4.1",
    "nodemailer": "7.0.6",
    "pg": "8.16.3",
    "pino": "9.9.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.6",
    "@swc/core": "1.13.5",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.12",
    "@types/nodemailer": "7.0.1",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "pino-pretty": "13.1.1",
    "supertest": "7.1.4",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.7",
    "vitest": "3.2.4"
  }
}
